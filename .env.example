# Estuda Anne — Modelo de Variáveis de Ambiente (Monorepo)

# Frontend (apps/frontend)
PORT=9000
# Em desenvolvimento local: http://localhost:3001
# Em produção VPS: https://estuda-anne.singulartech.space
NEXT_PUBLIC_BFF_URL=http://localhost:3001
