FROM node:20-alpine AS builder

WORKDIR /app

# Instala o pnpm no container
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# Copia manifestos e lockfiles do monorepo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/bff/package.json apps/bff/

# Instala todas as dependências
RUN pnpm install --frozen-lockfile

# Copia o código fonte
COPY packages/shared packages/shared
COPY apps/bff apps/bff

# Compila o código TypeScript do shared e do bff
RUN pnpm --filter @estuda-anne/shared build
RUN pnpm --filter @estuda-anne/bff build

# Estágio Final de Produção
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
ENV STUDY_ENGINE_URL=http://study-engine:3002
ENV AUTH_SERVICE_URL=http://auth:3005

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/bff/package.json apps/bff/

RUN pnpm install --prod --frozen-lockfile

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/bff/dist ./apps/bff/dist

EXPOSE 3001

CMD ["node", "apps/bff/dist/index.js"]
